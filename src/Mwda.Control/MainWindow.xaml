<Window x:Class="Mwda.Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MWDA Control"
        MinWidth="900"
        MinHeight="620"
        Width="1120"
        Height="760"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="24,18"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Wireless display adapter"
                               Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="{Binding Connection.SelectedAdapter.DeviceName, TargetNullValue=No adapter selected}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="Selected adapter" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="IP " Style="{StaticResource HeaderDetailTextStyle}" />
                        <TextBlock Text="{Binding Connection.SelectedAdapter.IpAddress, TargetNullValue=Not connected}"
                                   Style="{StaticResource HeaderDetailTextStyle}"
                                   AutomationProperties.Name="Selected adapter IP address" />
                        <TextBlock Text="  •  " Style="{StaticResource HeaderDetailTextStyle}" />
                        <TextBlock Text="{Binding Connection.ConnectionState}"
                                   Style="{StaticResource HeaderDetailTextStyle}"
                                   AutomationProperties.Name="Adapter connection state" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding Connection.RefreshCommand}"
                        MinWidth="104"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Refresh adapter discovery" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12,18"
                    Background="{DynamicResource NavigationBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         AutomationProperties.Name="Settings navigation">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="15"
                                       AutomationProperties.Name="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1">
                <ContentControl Content="{Binding SelectedPageViewModel}"
                                Margin="28,24" />

                <ContentControl Content="{Binding Connection}"
                                Panel.ZIndex="10"
                                Background="{DynamicResource WindowBackgroundBrush}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Connection.IsConnected}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
