<UserControl x:Class="Mwda.Control.Views.DisconnectedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Disconnected adapter view">
    <Grid>
        <StackPanel MaxWidth="620"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="Connect an adapter"
                       Style="{StaticResource PageTitleStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Use Windows wireless display settings to connect the adapter, then return here and refresh."
                       Style="{StaticResource PageIntroStyle}"
                       TextAlignment="Center" />

            <Border Style="{StaticResource StatusBannerStyle}"
                    AutomationProperties.Name="Connection status banner">
                <TextBlock Text="{Binding ResultBanner}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Connection status" />
            </Border>

            <TextBlock Text="The control pages remain local to this app and preserve any edits while the adapter is unavailable."
                       Style="{StaticResource HintTextStyle}"
                       TextAlignment="Center" />
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    MinWidth="120"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Refresh adapter discovery" />
        </StackPanel>
    </Grid>
</UserControl>
