<UserControl x:Class="Mwda.Control.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Diagnostics view">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720">
            <TextBlock Text="Diagnostics"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Review the last probe, current operation state, and local redacted error details."
                       Style="{StaticResource PageIntroStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                               Text="Latest probe"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Adapter"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding Identity.DeviceName, TargetNullValue=Unavailable}"
                               AutomationProperties.Name="Last probe adapter" />
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Model"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding Identity.Model, TargetNullValue=Unavailable}"
                               AutomationProperties.Name="Last probe model" />
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="Generation"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding Identity.Generation}"
                               AutomationProperties.Name="Last probe generation" />
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="Version"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               Text="{Binding Identity.FirmwareVersion, TargetNullValue=Unavailable}"
                               AutomationProperties.Name="Last probe firmware version" />
                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Text="MAC address"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Text="{Binding Identity.MacAddress, TargetNullValue=Unavailable}"
                               AutomationProperties.Name="Last probe MAC address" />
                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Text="IP address"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="6" Grid.Column="1"
                               Text="{Binding AdapterAddress, TargetNullValue=Unavailable}"
                               AutomationProperties.Name="Last probe address" />
                    <TextBlock Grid.Row="7" Grid.Column="0"
                               Text="Operation status"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="7" Grid.Column="1"
                               Text="{Binding DataContext.Connection.ConnectionState, RelativeSource={RelativeSource AncestorType={x:Type Window}}, TargetNullValue=Unavailable}"
                               AutomationProperties.Name="Current operation status" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Adapter recovery"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Restart / reboot the adapter when it needs to be recovered."
                               Style="{StaticResource HintTextStyle}" />
                    <TextBlock Text="This interrupts wireless display connections. It does not erase the adapter name, PIN, wallpaper, or other settings."
                               Style="{StaticResource HintTextStyle}"
                               AutomationProperties.Name="Restart warning" />
                    <Button Content="Restart adapter"
                            Click="RestartAdapterClick"
                            IsEnabled="{Binding CanRestart}"
                            AutomationProperties.Name="Restart adapter" />
                    <ProgressBar Width="90"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding RestartCommand.IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="Restarting adapter" />
                    <Border Style="{StaticResource StatusBannerStyle}"
                            AutomationProperties.Name="Restart status banner">
                        <TextBlock Text="{Binding ResultBanner}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Restart operation result" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Last result"
                               Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource StatusBannerStyle}"
                            DataContext="{Binding DataContext.Connection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            AutomationProperties.Name="Diagnostics status banner">
                        <TextBlock Text="{Binding ResultBanner}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Diagnostics operation result" />
                    </Border>
                    <TextBlock Text="Local error details"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding LastError, Mode=OneWay, TargetNullValue=No local errors recorded}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             MinHeight="64"
                             AutomationProperties.Name="Redacted local error details" />
                    <Button Content="Copy diagnostics"
                            Click="CopyDiagnosticsClick"
                            AutomationProperties.Name="Copy diagnostics" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
